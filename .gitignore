# dependencies and builds
node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/.tools/
/.tools/

# Blender source packs: large, third-party, not in the repo (see blender/sources/LICENSES.md)
blender/sources/*
!blender/sources/LICENSES.md
blender/*.blend1
blender/*.blend2

# local secrets: never commit keys
.env
.env.*
!.env.example
supabase/.temp/
*.log

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Kenney source packs and videos stay outside the repository (blender/sources/LICENSES.md)
Kenny/
Video/

# Local asset library: large sources, not in the repo. The game uses the
# optimised copies under web/public/assets/ (see docs/superpowers/specs).
# Anchored to the root: on Windows (core.ignorecase) "Assets/" would also hide web/public/assets/.
/Assets/

# Local package caches and temporary build output
.npm-cache/
web/.npm-cache/
web/.tmp-build/
/test-results/

# Approved reference prototype and its asset copies stay local.
# Already tracked files in Prototyp/ remain tracked.
/Prototyp/
.tmp-build/
